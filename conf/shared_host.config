// Limits for running locally on a shared CHTC access point (user rules: <= 16 threads,
// stay well under 180 GB RAM). Use with: nextflow run . -c conf/shared_host.config ...
// The local executor never schedules more than this in total, so at most one 16-CPU
// EsViritu task runs at a time, with smaller tasks fitting around it.
executor {
    $local {
        cpus = 16
        memory = '160 GB'
    }
}
