// Limits for running locally on a shared CHTC access point (user rules: <= 16 threads,
// stay well under 180 GB RAM). Use with: nextflow run . -c conf/shared_host.config ...
// The local executor never schedules more than this in total.
executor {
    $local {
        cpus = 16
        memory = '160 GB'
    }
}

// EsViritu averaged ~3.6 busy CPUs out of the 16 that process_high reserves (batch2 run), so
// each task held the whole budget and samples ran one at a time. At 6 CPUs two run at once
// and 4 CPUs stay free for the small per-sample table builders.
process {
    withName: 'ESVIRITU' {
        cpus = 6
    }
}
