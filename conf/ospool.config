// Run on UW-Madison CHTC / OSPool through the nf-ospool executor with per-process containers.
// Launch from /home, never /staging (HTCondor cannot submit from there):
//   nextflow run <project> -c <project>/conf/ospool.config -params-file params.yaml
// The params file must set ospool_staging_root (a folder on /staging that holds containers/ and
// work/) and ospool_accounting_group. Input, reference and output paths must also be on /staging.

plugins {
    id 'nf-ospool@0.1.1'
}

workDir = "${params.ospool_staging_root}/work"

singularity {
    enabled = true
    autoMounts = true
    // Execute nodes read the images from here, so it must be on /staging.
    cacheDir = "${params.ospool_staging_root}/containers"
    pullTimeout = '60 min'
    // RESOLVE_READ_INPUTS expands samplesheet globs inside the container, before those files are
    // declared task inputs, so autoMounts alone does not make them visible.
    runOptions = '-B /staging'
}

executor {
    queueSize = 60
    $ospool {
        submitFileDir = "${System.getProperty('user.home')}/.nextflow/ospool-submit"
        // Left unset, the plugin copies the WHOLE project folder to /staging, including any
        // real-samples/, runs/ and ref/ folders. Tasks only need assets/ (bin/ is staged separately).
        autoStageDirectories = ["${projectDir}/assets"]
        // Key from `readlink -f /staging` on this access point.
        pathMappings = ['/mnt/htc-cephfs/kernel/root/staging': '/staging']
    }
}

process {
    executor = 'ospool'
    disk = 10.GB
    // OSPool nodes get preempted, and a retry also gets more memory where it is set per attempt.
    errorStrategy = 'retry'
    maxRetries = 2

    // The requirements expression is what limits jobs to nodes with /staging, and that is what
    // makes it safe to switch off HTCondor's copy of outputs back to /home.
    clusterOptions = """
    requirements = ((OpSysMajorVer == 8) || (OpSysMajorVer == 9)) && (Target.HasCHTCStaging == true)
    +AccountingGroup = "${params.ospool_accounting_group}"
    transfer_output_files = ""
    """

    // Containers. rww_helpers is built from conf/containers/rww_helpers.def; the rest are BioContainers.
    withName: 'RESOLVE_READ_INPUTS|REFERENCE_FILTER|REFERENCE_FILTER_SRA|FETCH_SRA_READS|BUILD_.*|WRITE_.*' {
        container = "${params.ospool_staging_root}/containers/rww_helpers_v1.sif"
    }
    withName: 'PREPARE_READS|BBDUK_TRIM_ADAPTERS|CLUMPIFY_DEDUP|BBDUK_FILTER_READS' {
        container = 'quay.io/biocontainers/bbmap:39.91--h09cc210_0'
    }
    withName: 'SYLPH_SKETCH_READS|SYLPH_PROFILE' {
        container = 'quay.io/biocontainers/sylph:1.0.0--hb42e459_0'
    }
    withName: 'ESVIRITU' {
        container = 'quay.io/biocontainers/esviritu:1.3.5--pyhdfd78af_0'
    }
    withName: 'MULTIQC' {
        container = 'quay.io/biocontainers/multiqc:1.35--pyhdfd78af_2'
    }

    // Requests from the peak use of the 18-sample run rww_20261029_32720. HTCondor enforces memory,
    // unlike the local executor. Disk covers each task's outputs and temp files; /staging inputs
    // are symlinked and do not count.
    withName: 'REFERENCE_FILTER|BBDUK_TRIM_ADAPTERS|PREPARE_READS' {
        memory = { 16.GB * task.attempt }
        disk = 150.GB
    }
    withName: 'CLUMPIFY_DEDUP' {
        // Peaked at 13.8 GB of 16 GB, too close to the limit.
        memory = { 32.GB * task.attempt }
        disk = 300.GB
    }
    withName: 'BBDUK_FILTER_READS' {
        memory = { 16.GB * task.attempt }
        disk = 100.GB
    }
    withName: 'SYLPH_SKETCH_READS' {
        // Peaked at 29.8 GB and used ~1.5 CPUs.
        cpus = 4
        memory = { 48.GB * task.attempt }
        disk = 50.GB
    }
    withName: 'SYLPH_PROFILE' {
        cpus = 2
        memory = { 8.GB * task.attempt }
    }
    withName: 'ESVIRITU' {
        // Peaked at 14 GB and used ~3.6 CPUs.
        cpus = 6
        memory = { 32.GB * task.attempt }
        disk = 150.GB
    }
}
