// Rapid wastewater metagenomics v1. Every tool setting has a spec-chosen default here and is
// exposed as a param (ADR 0001); a run overrides values in its own params YAML (-params-file).

manifest {
    name = 'rapid-ww-metagenomics'
    description = 'Weekly wastewater viral surveillance: Deacon host depletion, BBTools read QC, sylph and EsViritu calling'
    version = '1.0.0dev'
    nextflowVersion = '>=26.04.0'
}

params {
    // Input / output
    input = null                    // NVD-format samplesheet (CSV)
    outdir = 'results'
    run_id = null                   // default rww_<YYYYMMDD>_<Nextflow runName>, set in main.nf

    // Host depletion (Deacon filter --deplete, unioned panhuman-1 + SILVA index)
    host_depletion_index = null
    host_depletion_abs_threshold = 2
    host_depletion_rel_threshold = 0.01
    host_depletion_complexity_threshold = null   // null = Deacon's default (no complexity filter)
    check_pairs = false                         // Deacon --check-pairs, as NVD
    max_concurrent_downloads = 3                // parallel SRA fetches

    // Read QC: NVD's BBTools chain and settings (modules/bbmap.nf)
    trim_adapters = true                        // BBDuk ktrim=r against bundled adapters (Illumina only)
    adapter_trim_kmer_length = 23               // k
    adapter_trim_min_kmer_length = 11           // mink
    adapter_trim_hamming_distance = 1           // hdist
    dedup = true                                // Clumpify dedupe=t
    dedup_substitutions = 0                     // subs (0 = exact duplicates only)
    min_read_quality_illumina = 20              // BBDuk minavgquality
    min_read_quality_nanopore = 12
    min_read_length = 50                        // BBDuk minlength
    filter_low_complexity_reads = true          // BBDuk entropy filter
    min_read_entropy = 0.5                      // entropy
    min_read_entropy_window = 50                // entropywindow
    min_read_entropy_kmer = 5                   // entropyk

    // Skips: a skipped step passes its input straight through
    skip_host_depletion = false
}

process {
    // Tools write temp files inside each task's work dir, never /tmp (shared CHTC hosts).
    beforeScript = 'export TMPDIR="$PWD/tmp" && mkdir -p "$TMPDIR"'

    withLabel: 'process_single' { cpus = 1; memory = '2 GB' }
    withLabel: 'process_medium' { cpus = 8; memory = '16 GB' }
}
