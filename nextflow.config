// Rapid wastewater metagenomics v1. Every tool setting has a spec-chosen default here and is
// exposed as a param (ADR 0001); a run overrides values in its own params YAML (-params-file).

manifest {
    name = 'rapid-ww-metagenomics'
    description = 'Weekly wastewater viral surveillance: Deacon host depletion, BBTools read QC, sylph and EsViritu calling'
    version = '1.0.0dev'
    nextflowVersion = '>=26.04.0'
}

params {
    // Input / output
    input = null                    // NVD-format samplesheet (CSV)
    outdir = 'results'
    run_id = null                   // default rww_<YYYYMMDD>_<Nextflow runName>, set in main.nf

    // Reference versions, recorded in run_metadata.yaml
    vpd_version = null
    vpd_mask_version = null
    taxdump_version = null

    // Host depletion (Deacon filter --deplete, unioned panhuman-1 + SILVA index)
    host_depletion_index = null
    host_depletion_index_description = 'panhuman-1 (HPRC Year 1 + CHM13v2.0 + GRCh38.p14, minus FDA-ARGOS bacteria and RefSeq viruses) + SILVA SSU 144 / LSU 138.2 NR99 rRNA'
    host_depletion_abs_threshold = 2
    host_depletion_rel_threshold = 0.01
    host_depletion_complexity_threshold = null   // null = Deacon's default (no complexity filter)
    check_pairs = false                         // Deacon --check-pairs, as NVD
    max_concurrent_downloads = 3                // parallel SRA fetches

    // Read QC: NVD's BBTools chain and settings (modules/bbmap.nf)
    trim_adapters = true                        // BBDuk ktrim=r against bundled adapters (Illumina only)
    adapter_trim_kmer_length = 23               // k
    adapter_trim_min_kmer_length = 11           // mink
    adapter_trim_hamming_distance = 1           // hdist
    dedup = true                                // Clumpify dedupe=t
    dedup_substitutions = 0                     // subs (0 = exact duplicates only)
    min_read_quality_illumina = 20              // BBDuk minavgquality
    min_read_quality_nanopore = 12
    min_read_length = 50                        // BBDuk minlength
    filter_low_complexity_reads = true          // BBDuk entropy filter
    min_read_entropy = 0.5                      // entropy
    min_read_entropy_window = 50                // entropywindow
    min_read_entropy_kmer = 5                   // entropyk

    // Genome k-mer-based calling (sylph, locked for v1: very low false-positive rate)
    sylph_database = null                       // .syldb built at sylph_database_kmer_length / _compression
    vpd_lookup = null                           // from bin/build_vpd_lookup.py
    sylph_database_kmer_length = 31
    sylph_database_compression = 50
    sylph_sample_kmer_length = 31
    sylph_sample_compression = 50
    sylph_minimum_ani = 90                      // --minimum-ani
    sylph_min_count_correct = 3                 // --min-count-correct
    sylph_min_reference_kmers = 1               // -M / --min-number-kmers
    sylph_min_matching_kmers = 0                // --min-contain
    sylph_redundancy_threshold = 99             // -R (hidden sylph flag, exposed)

    // Genome mapping-based calling (EsViritu 1.3.5)
    esviritu_database = null                    // directory: virus_pathogen_database.{fna,fna.fai,mmi,all_metadata.tsv}
    esviritu_dedup = false                      // --dedup (dedup already ran in read QC)
    esviritu_min_align_length = 100             // --min-align-length
    esviritu_species_threshold = 0.9            // --species-threshold (below it: genus-level call)
    esviritu_subspecies_threshold = 0.95        // --subspecies-threshold
    esviritu_minimap2_batch = '50M'             // -mmK; lower it to cut EsViritu's memory
    esviritu_minimap2_preset_illumina = 'sr'    // -mmP
    esviritu_minimap2_preset_nanopore = 'lr:hq'
    mapping_based_call_min_read_count = 1       // a call needs at least this many reads
    normalization_genus = 'Tobamovirus'         // normalized_read_ratio denominator, VPD genus name

    // Skips: a skipped step passes its input straight through. Adapter trimming and dedup are
    // switched off with NVD's trim_adapters / dedup params above.
    skip_host_depletion = false
    skip_read_filtering = false
    skip_genome_kmer_based_calling = false
    skip_genome_mapping_based_calling = false
}

outputDir = params.outdir

process {
    // Tools write temp files inside each task's work dir, never /tmp (shared CHTC hosts).
    beforeScript = 'export TMPDIR="$PWD/tmp" && mkdir -p "$TMPDIR"'

    withLabel: 'process_single' { cpus = 1; memory = '2 GB' }
    withLabel: 'process_medium' { cpus = 8; memory = '16 GB' }
    withLabel: 'process_high' { cpus = 16; memory = '64 GB' }
}
