config {
    // nf-core layout: each module keeps its tests next to it in <module>/tests/.
    testsDir "."
    // Reference checkouts and scratch space are not part of this pipeline.
    // .claude/** holds git worktrees: without it nf-test discovers their stale copies of these
    // same tests and runs them against whatever code that worktree was left on.
    ignore "reference-source-code/**", "personal-esviritu-fork/**", "agent-skills/**", ".scratch/**", ".pixi/**", ".nf-test/**", ".claude/**"
    // Keep nf-test's Nextflow work dirs under the project, never /tmp.
    workDir ".nf-test"
    configFile "tests/config/nextflow.config"
    profile ""
}
