nextflow_process {

    name "Test SYLPH_PROFILE"
    script "../main.nf"
    process "SYLPH_PROFILE"

    test("both_callers: every sampled genome is called") {
        setup {
            run("HOST_DEPLETION") {
                script "../../host_depletion/main.nf"
                process {
                    """
                    def reads = "${projectDir}/tests/data/generated/reads"
                    input[0] = Channel.of([
                        [id: 'both_callers', platform: 'illumina', read_mode: 'paired', r1_count: 1],
                        [file("\${reads}/both_callers_R1.fastq.gz"), file("\${reads}/both_callers_R2.fastq.gz")],
                    ])
                    input[1] = file("${projectDir}/tests/data/generated/references/host.k31w15.idx")
                    """
                }
            }
            run("SYLPH_SKETCH_READS") {
                script "../../sylph_sketch_reads/main.nf"
                process {
                    """
                    input[0] = HOST_DEPLETION.out.reads.map { meta, depleted_fastq, read_count -> [meta, depleted_fastq] }
                    """
                }
            }
        }
        when {
            process {
                """
                input[0] = SYLPH_SKETCH_READS.out.sketch
                input[1] = file("${projectDir}/tests/data/generated/references/vpd.syldb")
                """
            }
        }
        then {
            assert process.success
            def rows = path(process.out.profile[0][1]).readLines().drop(1)*.split('\t')
            def called_genome_files = rows.collect { new File(it[1]).name } as Set
            assert called_genome_files == ['GCF_000859645.1.fna', 'GCF_001461485.1.fna', 'acc_ON897592.1.fna', 'set_43d19931109e46219fb3876e13775cee063e1ed0.fna', 'PSVA_S2-2__Sadwavirus_alphananas.fna'] as Set
        }
    }

    test("kmer_only: the short-read enterovirus is called") {
        setup {
            run("HOST_DEPLETION") {
                script "../../host_depletion/main.nf"
                process {
                    """
                    def reads = "${projectDir}/tests/data/generated/reads"
                    input[0] = Channel.of([
                        [id: 'kmer_only', platform: 'illumina', read_mode: 'paired', r1_count: 1],
                        [file("\${reads}/kmer_only_R1.fastq.gz"), file("\${reads}/kmer_only_R2.fastq.gz")],
                    ])
                    input[1] = file("${projectDir}/tests/data/generated/references/host.k31w15.idx")
                    """
                }
            }
            run("SYLPH_SKETCH_READS") {
                script "../../sylph_sketch_reads/main.nf"
                process {
                    """
                    input[0] = HOST_DEPLETION.out.reads.map { meta, depleted_fastq, read_count -> [meta, depleted_fastq] }
                    """
                }
            }
        }
        when {
            process {
                """
                input[0] = SYLPH_SKETCH_READS.out.sketch
                input[1] = file("${projectDir}/tests/data/generated/references/vpd.syldb")
                """
            }
        }
        then {
            assert process.success
            def rows = path(process.out.profile[0][1]).readLines().drop(1)*.split('\t')
            def called_genome_files = rows.collect { new File(it[1]).name } as Set
            assert called_genome_files == ['set_MF678311.fna'] as Set
        }
    }

    test("mapping_only: 12 % diverged norovirus is below the ANI floor") {
        setup {
            run("HOST_DEPLETION") {
                script "../../host_depletion/main.nf"
                process {
                    """
                    def reads = "${projectDir}/tests/data/generated/reads"
                    input[0] = Channel.of([
                        [id: 'mapping_only', platform: 'illumina', read_mode: 'paired', r1_count: 1],
                        [file("\${reads}/mapping_only_R1.fastq.gz"), file("\${reads}/mapping_only_R2.fastq.gz")],
                    ])
                    input[1] = file("${projectDir}/tests/data/generated/references/host.k31w15.idx")
                    """
                }
            }
            run("SYLPH_SKETCH_READS") {
                script "../../sylph_sketch_reads/main.nf"
                process {
                    """
                    input[0] = HOST_DEPLETION.out.reads.map { meta, depleted_fastq, read_count -> [meta, depleted_fastq] }
                    """
                }
            }
        }
        when {
            process {
                """
                input[0] = SYLPH_SKETCH_READS.out.sketch
                input[1] = file("${projectDir}/tests/data/generated/references/vpd.syldb")
                """
            }
        }
        then {
            assert process.success
            def rows = path(process.out.profile[0][1]).readLines().drop(1)*.split('\t')
            def called_genome_files = rows.collect { new File(it[1]).name } as Set
            assert called_genome_files == [] as Set
        }
    }

    test("neither: background and repeats give no call") {
        setup {
            run("HOST_DEPLETION") {
                script "../../host_depletion/main.nf"
                process {
                    """
                    def reads = "${projectDir}/tests/data/generated/reads"
                    input[0] = Channel.of([
                        [id: 'neither', platform: 'illumina', read_mode: 'paired', r1_count: 1],
                        [file("\${reads}/neither_R1.fastq.gz"), file("\${reads}/neither_R2.fastq.gz")],
                    ])
                    input[1] = file("${projectDir}/tests/data/generated/references/host.k31w15.idx")
                    """
                }
            }
            run("SYLPH_SKETCH_READS") {
                script "../../sylph_sketch_reads/main.nf"
                process {
                    """
                    input[0] = HOST_DEPLETION.out.reads.map { meta, depleted_fastq, read_count -> [meta, depleted_fastq] }
                    """
                }
            }
        }
        when {
            process {
                """
                input[0] = SYLPH_SKETCH_READS.out.sketch
                input[1] = file("${projectDir}/tests/data/generated/references/vpd.syldb")
                """
            }
        }
        then {
            assert process.success
            def rows = path(process.out.profile[0][1]).readLines().drop(1)*.split('\t')
            def called_genome_files = rows.collect { new File(it[1]).name } as Set
            assert called_genome_files == [] as Set
        }
    }
}
